    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CrashScope.Service</AssemblyName>
    <RootNamespace>CrashScope.Service</RootNamespace>
    <Version>0.4.0</Version>
    <Description>CrashScope Windows Service – background flight recorder</Description>
