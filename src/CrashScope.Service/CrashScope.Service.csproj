<!-- The Worker SDK supplies the Microsoft.Extensions.Hosting / DependencyInjection /
     Logging implicit usings that Program.cs and SessionRecorderWorker.cs rely on;
     plain Microsoft.NET.Sdk does not, which broke the build with CS0246. -->
<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CrashScope.Service</AssemblyName>
    <RootNamespace>CrashScope.Service</RootNamespace>
    <Version>0.9.0</Version>
    <Description>CrashScope Windows Service – background flight recorder</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.EventLog" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrashScope.Core\CrashScope.Core.csproj" />
  </ItemGroup>
</Project>