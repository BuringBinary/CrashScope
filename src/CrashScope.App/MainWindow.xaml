<Window x:Class="CrashScope.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CrashScope"
        Width="1320"
        Height="820"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0E1118" BorderBrush="#202735" BorderThickness="0,0,1,0">
            <Grid Margin="18,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="CrashScope" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}" />
                    <TextBlock Text="PLAYER SYSTEM" Margin="1,4,0,0" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                </StackPanel>

                <Border Grid.Row="1" Margin="0,22,0,0" Padding="10,8" CornerRadius="8" Background="#121824" BorderBrush="#202A3A" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="SidebarStatusDot" Width="8" Height="8" Margin="0,0,8,0" Fill="{StaticResource DangerBrush}" />
                        <TextBlock x:Name="SidebarStatusText" Text="Agent offline" FontSize="12" Foreground="{StaticResource SecondaryText}" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="3">
                    <Button x:Name="DashboardNavButton" Style="{StaticResource NavButtonStyle}" Background="{StaticResource AccentSoftBrush}" Foreground="{StaticResource PrimaryText}" Content="Dashboard" Click="DashboardNavButton_Click" />
                    <Button Style="{StaticResource NavButtonStyle}" Margin="0,4,0,0" Content="Hardware" Click="DashboardNavButton_Click" />
                    <Button x:Name="IncidentsNavButton" Style="{StaticResource NavButtonStyle}" Margin="0,4,0,0" Content="Incidents" Click="IncidentsNavButton_Click" />
                    <Button Style="{StaticResource NavButtonStyle}" Margin="0,4,0,0" Content="Overlay" />
                    <Button Style="{StaticResource NavButtonStyle}" Margin="0,4,0,0" Content="Toolbox" />
                    <Button Style="{StaticResource NavButtonStyle}" Margin="0,4,0,0" Content="Game Profiles" />
                    <Button Style="{StaticResource NavButtonStyle}" Margin="0,4,0,0" Content="Settings" />
                </StackPanel>

                <StackPanel Grid.Row="4">
                    <TextBlock Text="LIVE RECORDER UI" FontSize="10" Foreground="#5F6B7C" />
                    <TextBlock Text="v0.1 foundation" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource SecondaryText}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid x:Name="DashboardPage" Margin="28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="System Dashboard" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Live telemetry from the CrashScope flight recorder" Margin="0,5,0,0" FontSize="13" Foreground="{StaticResource SecondaryText}" />
                    </StackPanel>
                    <Border Grid.Column="1" VerticalAlignment="Center" Padding="12,7" Background="#11151D" BorderBrush="#202735" BorderThickness="1" CornerRadius="12">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="HeaderStatusDot" Width="8" Height="8" Margin="0,0,8,0" Fill="{StaticResource DangerBrush}" />
                            <TextBlock x:Name="HeaderStatusText" Text="Disconnected" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="RECORDER" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SecondaryText}" />
                            <TextBlock x:Name="RecorderValueText" Text="Offline" Margin="0,10,0,0" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock x:Name="RecorderDetailText" Text="Waiting for Agent" Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="FOREGROUND APP" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SecondaryText}" />
                            <TextBlock x:Name="ForegroundValueText" Text="—" Margin="0,10,0,0" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ForegroundDetailText" Text="No live sample" Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource SecondaryText}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="USER IDLE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SecondaryText}" />
                            <TextBlock x:Name="IdleValueText" Text="—" Margin="0,10,0,0" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="Time since last input" Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource SecondaryText}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="LAST SAMPLE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SecondaryText}" />
                            <TextBlock x:Name="LastSampleValueText" Text="—" Margin="0,10,0,0" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock x:Name="LastSampleDetailText" Text="No telemetry yet" Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource SecondaryText}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                            <TextBlock Text="CPU LOAD" FontSize="10" Foreground="{StaticResource SecondaryText}" />
                            <TextBlock Grid.Row="1" x:Name="CpuLoadValueText" Text="—" Margin="0,5,0,3" FontSize="20" FontWeight="SemiBold" />
                            <Polyline Grid.Row="2" x:Name="CpuLoadSparkline" Stretch="Fill" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Fill="Transparent" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                            <TextBlock Text="CPU TEMP" FontSize="10" Foreground="{StaticResource SecondaryText}" />
                            <TextBlock Grid.Row="1" x:Name="CpuTempValueText" Text="—" Margin="0,5,0,3" FontSize="20" FontWeight="SemiBold" />
                            <Polyline Grid.Row="2" x:Name="CpuTempSparkline" Stretch="Fill" Stroke="#F59E0B" StrokeThickness="2" Fill="Transparent" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                            <TextBlock Text="GPU LOAD" FontSize="10" Foreground="{StaticResource SecondaryText}" />
                            <TextBlock Grid.Row="1" x:Name="GpuLoadValueText" Text="—" Margin="0,5,0,3" FontSize="20" FontWeight="SemiBold" />
                            <Polyline Grid.Row="2" x:Name="GpuLoadSparkline" Stretch="Fill" Stroke="#8B5CF6" StrokeThickness="2" Fill="Transparent" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="6" Style="{StaticResource CardStyle}" Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                            <TextBlock Text="GPU TEMP" FontSize="10" Foreground="{StaticResource SecondaryText}" />
                            <TextBlock Grid.Row="1" x:Name="GpuTempValueText" Text="—" Margin="0,5,0,3" FontSize="20" FontWeight="SemiBold" />
                            <Polyline Grid.Row="2" x:Name="GpuTempSparkline" Stretch="Fill" Stroke="#EC4899" StrokeThickness="2" Fill="Transparent" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="Live Hardware" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="SensorSummaryText" HorizontalAlignment="Right" VerticalAlignment="Center" Text="0 sensors" FontSize="11" Foreground="{StaticResource SecondaryText}" />
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding HardwareGroups}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="440" Margin="0,0,14,14" Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding HardwareName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="1" Padding="7,3" Background="#171C27" CornerRadius="6">
                                                    <TextBlock Text="{Binding HardwareType}" FontSize="9" Foreground="{StaticResource SecondaryText}" />
                                                </Border>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Sensors}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding SensorName}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding SensorType}" Margin="0,1,0,0" FontSize="9" Foreground="#687487" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding ValueText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Grid x:Name="IncidentsPage" Visibility="Collapsed" Margin="28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Incident Center" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Evidence captured after an unclean shutdown or freeze" Margin="0,5,0,0" FontSize="13" Foreground="{StaticResource SecondaryText}" />
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Center" Padding="14,8" Content="Refresh" Click="RefreshIncidentsButton_Click" />
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel><TextBlock Text="INCIDENTS" FontSize="10" Foreground="{StaticResource SecondaryText}"/><TextBlock x:Name="IncidentCountText" Text="0" Margin="0,8,0,0" FontSize="24" FontWeight="SemiBold"/></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel><TextBlock Text="LATEST" FontSize="10" Foreground="{StaticResource SecondaryText}"/><TextBlock x:Name="LatestIncidentText" Text="—" Margin="0,8,0,0" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                        <StackPanel><TextBlock Text="LAST REFRESH" FontSize="10" Foreground="{StaticResource SecondaryText}"/><TextBlock x:Name="IncidentRefreshText" Text="—" Margin="0,8,0,0" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="4">
                    <TextBlock x:Name="IncidentEmptyText" Text="No incidents recorded yet. CrashScope will create one after it detects an unclean previous session." Foreground="{StaticResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Incidents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,12" Style="{StaticResource CardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding TimeText}" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding SessionText}" Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource SecondaryText}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="16,0">
                                                <TextBlock Text="Evidence" FontSize="10" Foreground="{StaticResource SecondaryText}" />
                                                <TextBlock Text="{Binding EvidenceText}" Margin="0,5,0,0" FontSize="13" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding DirectoryPath}" Margin="0,5,0,0" FontSize="9" Foreground="#687487" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Padding="10,5" VerticalAlignment="Top" Background="#171C27" CornerRadius="8">
                                                <TextBlock Text="{Binding EvidenceCount, StringFormat={}{0} signals}" FontSize="10" Foreground="{StaticResource SecondaryText}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
