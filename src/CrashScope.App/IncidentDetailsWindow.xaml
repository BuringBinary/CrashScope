<Window x:Class="CrashScope.App.IncidentDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CrashScope Incident"
        Width="1220"
        Height="820"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Incident Timeline" FontSize="28" FontWeight="SemiBold" />
                <TextBlock x:Name="IncidentIdText" Margin="0,5,0,0" Text="Loading incident…" FontSize="12" Foreground="{StaticResource SecondaryText}" />
            </StackPanel>
            <Button Grid.Column="1" Padding="14,8" VerticalAlignment="Center" Content="Close" Click="CloseButton_Click" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="EVIDENCE" FontSize="10" Foreground="{StaticResource SecondaryText}" />
                    <TextBlock x:Name="EvidenceText" Margin="0,7,0,0" Text="Loading…" FontSize="14" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="CAPTURE WINDOW" FontSize="10" Foreground="{StaticResource SecondaryText}" />
                    <TextBlock x:Name="WindowText" Margin="0,7,0,0" Text="—" FontSize="13" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="HARDWARE MAP" FontSize="10" Foreground="{StaticResource SecondaryText}" />
                    <TextBlock x:Name="CatalogText" Margin="0,7,0,0" Text="—" FontSize="13" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="Hardware Before Failure" FontSize="17" FontWeight="SemiBold" />
                <TextBlock x:Name="MetricsHintText" HorizontalAlignment="Right" VerticalAlignment="Center" Text="last ~5 minutes" FontSize="10" Foreground="{StaticResource SecondaryText}" />
            </Grid>
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Metrics}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,12,0" Padding="14,12" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="52" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{StaticResource SecondaryText}" />
                                <TextBlock Grid.Row="1" Text="{Binding LatestValueText}" Margin="0,5,0,4" FontSize="18" FontWeight="SemiBold" />
                                <Polyline Grid.Row="2" Points="{Binding Points}" Stretch="Fill" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Fill="Transparent" />
                                <TextBlock Grid.Row="3" Text="{Binding RangeText}" Margin="0,4,0,0" FontSize="9" Foreground="#687487" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Grid Grid.Row="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="Unified Timeline" FontSize="17" FontWeight="SemiBold" />
                <TextBlock x:Name="TimelineCountText" HorizontalAlignment="Right" VerticalAlignment="Center" Text="0 events" FontSize="10" Foreground="{StaticResource SecondaryText}" />
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Timeline}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TimeText}" Margin="0,8,10,0" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource SecondaryText}" />
                                    <Grid Grid.Column="1">
                                        <Border Width="2" HorizontalAlignment="Center" Background="#263043" />
                                        <Ellipse Width="10" Height="10" VerticalAlignment="Top" Margin="0,11,0,0" Fill="{Binding SeverityBrush}" />
                                    </Grid>
                                    <Border Grid.Column="2" Padding="12,9" Background="#0F131B" BorderBrush="#202735" BorderThickness="1" CornerRadius="9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="94" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Kind}" Margin="0,2,12,0" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detail}" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
