<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>CrashScope.Desktop</AssemblyName>
    <RootNamespace>CrashScope.Desktop</RootNamespace>
    <Version>0.4.0</Version>
    <Description>CrashScope desktop application</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrashScope.Core\CrashScope.Core.csproj" />
  </ItemGroup>
</Project>