<Window x:Class="CrashScope.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:CrashScope.Desktop.Pages"
        Title="CrashScope"
        Width="1200" Height="750"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ContentBg}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0F0F1A" Offset="0"/>
                <GradientStop Color="#1A1B2E" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="#1A1B2E" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="1"
                           Text="CrashScope"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets"
                            Width="40" Height="40" FontSize="10"
                            Style="{StaticResource TitleBarButton}"
                            Click="MinimizeButton_Click"/>
                    <Button x:Name="MaxRestoreButton"
                            Content="&#xE922;" FontFamily="Segoe MDL2 Assets"
                            Width="40" Height="40" FontSize="10"
                            Style="{StaticResource TitleBarButton}"
                            Click="MaxRestoreButton_Click"/>
                    <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                            Width="40" Height="40" FontSize="10"
                            Style="{StaticResource TitleBarCloseButton}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Body: sidebar + content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{StaticResource SidebarBg}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- App title in sidebar -->
                        <StackPanel Grid.Row="0" Margin="20,24,20,16">
                            <TextBlock Text="CRASHSCOPE"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource AccentColor}"/>
                            <TextBlock Text="Windows Flight Recorder"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Navigation -->
                        <StackPanel Grid.Row="1" Margin="8,0">
                            <RadioButton x:Name="NavRecorder"
                                         Content="&#xE916;  Recorder"
                                         FontFamily="Segoe MDL2 Assets"
                                         Style="{StaticResource NavButton}"
                                         IsChecked="True"
                                         Checked="NavButton_Checked"
                                         Tag="Recorder"/>
                            <RadioButton x:Name="NavDashboard"
                                         Content="&#xE9D2;  Dashboard"
                                         FontFamily="Segoe MDL2 Assets"
                                         Style="{StaticResource NavButton}"
                                         Checked="NavButton_Checked"
                                         Tag="Dashboard"/>
                            <RadioButton x:Name="NavLiveMonitor"
                                         Content="&#xE7F7;  Live Monitor"
                                         FontFamily="Segoe MDL2 Assets"
                                         Style="{StaticResource NavButton}"
                                         Checked="NavButton_Checked"
                                         Tag="LiveMonitor"/>
                            <RadioButton x:Name="NavIncidents"
                                         Content="&#xEA80;  Incidents"
                                         FontFamily="Segoe MDL2 Assets"
                                         Style="{StaticResource NavButton}"
                                         Checked="NavButton_Checked"
                                         Tag="Incidents"/>
                            <RadioButton x:Name="NavTimeline"
                                         Content="&#xE8F0;  Timeline"
                                         FontFamily="Segoe MDL2 Assets"
                                         Style="{StaticResource NavButton}"
                                         Checked="NavButton_Checked"
                                         Tag="Timeline"/>
                            <RadioButton x:Name="NavSettings"
                                         Content="&#xE713;  Settings"
                                         FontFamily="Segoe MDL2 Assets"
                                         Style="{StaticResource NavButton}"
                                         Checked="NavButton_Checked"
                                         Tag="Settings"/>
                        </StackPanel>

                        <!-- Bottom status -->
                        <StackPanel Grid.Row="2" Margin="20,0,20,20">
                            <Border Background="{StaticResource CardBg}"
                                    CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="v0.5.0-dev"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock x:Name="StatusText"
                                               Text="Recorder: Stopped"
                                               FontSize="11"
                                               Foreground="{StaticResource DangerColor}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Content area -->
                <Border Grid.Column="1" Background="{StaticResource ContentBg}">
                    <Grid x:Name="ContentArea" Margin="24"/>
                </Border>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2" Background="#1A1B2E" Padding="12,0">
                <Grid>
                    <TextBlock x:Name="StatusBarText"
                               Text="Ready"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>