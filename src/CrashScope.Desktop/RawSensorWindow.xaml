<Window x:Class="CrashScope.Desktop.RawSensorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CrashScope — Raw Sensors"
        Width="760" Height="560"
        MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ContentBg}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <CheckBox x:Name="TopmostToggle" Content="Topmost"
                          VerticalAlignment="Center" Margin="0,0,12,0"
                          Foreground="{StaticResource TextSecondary}"
                          Checked="TopmostToggle_Changed" Unchecked="TopmostToggle_Changed"/>
                <Button x:Name="RefreshButton" Content="Refresh catalog" Height="26" Padding="10,0"
                        Style="{StaticResource SecondaryButton}"
                        Click="RefreshButton_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="SearchBox" Width="220" Height="26"
                         VerticalContentAlignment="Center"
                         TextChanged="Filter_Changed"/>
                <ComboBox x:Name="TypeFilter" Width="150" Height="26" Margin="8,0,0,0"
                          SelectionChanged="Filter_Changed"/>
            </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="1" x:Name="StatusText" Margin="0,0,0,8"
                   FontSize="11" Foreground="{StaticResource TextSecondary}"/>

        <ListView Grid.Row="2" x:Name="SensorList"
                  Background="Transparent" BorderThickness="0"
                  Foreground="{StaticResource TextPrimary}">
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentColor}" Margin="0,8,0,4"/>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Sensor" Width="260" DisplayMemberBinding="{Binding Sensor}"/>
                    <GridViewColumn Header="Type" Width="100" DisplayMemberBinding="{Binding SensorType}"/>
                    <GridViewColumn Header="Value" Width="110" DisplayMemberBinding="{Binding ValueText}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
