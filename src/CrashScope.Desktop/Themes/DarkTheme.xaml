<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Palette only. Shared templates live in ControlStyles.xaml. WPF uses ARGB. -->
    <SolidColorBrush x:Key="SidebarBg" Color="#14181F"/>
    <SolidColorBrush x:Key="ContentBg" Color="#0D1117"/>
    <SolidColorBrush x:Key="ContentBgAlt" Color="#11161E"/>
    <SolidColorBrush x:Key="CardBg" Color="#191F29"/>
    <SolidColorBrush x:Key="CardBgAlt" Color="#11161E"/>
    <SolidColorBrush x:Key="AccentColor" Color="#A5A0FF"/>
    <SolidColorBrush x:Key="AccentHover" Color="#B9B5FF"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#F0F3F9"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#ADB7C8"/>
    <SolidColorBrush x:Key="GpuColor" Color="#52D6AE"/>
    <SolidColorBrush x:Key="CpuColor" Color="#A5A0FF"/>
    <SolidColorBrush x:Key="RamColor" Color="#E5BE75"/>
    <SolidColorBrush x:Key="SuccessColor" Color="#52D6AE"/>
    <SolidColorBrush x:Key="WarningColor" Color="#E5BE75"/>
    <SolidColorBrush x:Key="DangerColor" Color="#FF929B"/>
    <SolidColorBrush x:Key="BorderColor" Color="#303A49"/>
    <SolidColorBrush x:Key="TitleBarBg" Color="#14181F"/>
    <SolidColorBrush x:Key="NavHoverBg" Color="#222B38"/>
    <SolidColorBrush x:Key="NavCheckedBg" Color="#2C2B48"/>
    <SolidColorBrush x:Key="ButtonSecondaryBg" Color="#252D3B"/>
    <SolidColorBrush x:Key="ButtonSecondaryHover" Color="#343F51"/>
    <SolidColorBrush x:Key="WindowGradientStart" Color="#0D1117"/>
    <SolidColorBrush x:Key="WindowGradientEnd" Color="#14181F"/>
    <SolidColorBrush x:Key="NavCheckedText" Color="#E5E1FF"/>
    <SolidColorBrush x:Key="FocusColor" Color="#B9B5FF"/>
    <SolidColorBrush x:Key="ActionBg" Color="#6554C0"/>
    <SolidColorBrush x:Key="ActionHover" Color="#7462CF"/>
    <SolidColorBrush x:Key="DangerButtonBg" Color="#B92E45"/>
    <SolidColorBrush x:Key="DangerButtonHover" Color="#CC3C54"/>
    <!-- Severity / category palette consumed by code-behind via SeverityPalette. -->
    <SolidColorBrush x:Key="SeverityCritical" Color="#FF929B"/>
    <SolidColorBrush x:Key="SeverityHigh" Color="#E5BE75"/>
    <SolidColorBrush x:Key="SeverityMedium" Color="#A5A0FF"/>
    <SolidColorBrush x:Key="SeverityLow" Color="#8B95A7"/>
    <SolidColorBrush x:Key="SeverityInfo" Color="#52D6AE"/>
    <SolidColorBrush x:Key="SeverityNeutral" Color="#8B95A7"/>
    <!-- Icon tile tints. WPF hex is #AARRGGBB: the alpha byte leads. -->
    <SolidColorBrush x:Key="CpuTint" Color="#26A5A0FF"/>
    <SolidColorBrush x:Key="GpuTint" Color="#2652D6AE"/>
    <SolidColorBrush x:Key="RamTint" Color="#26E5BE75"/>
    <SolidColorBrush x:Key="WarningTint" Color="#26E5BE75"/>
    <!-- Text placed on a saturated accent/severity fill, not on a surface.
         This theme's accent/severity fills are PASTEL (#A5A0FF, #52D6AE, #E5BE75, #FF929B),
         so white text on them measures only 1.8-2.3:1. Near-black is required here and
         reaches 7.4-11.6:1. Do not "fix" this to white to match the light theme. -->
    <SolidColorBrush x:Key="OnAccentText" Color="#14161F"/>
    <Color x:Key="WindowGradientStartColor">#0D1117</Color>
    <Color x:Key="WindowGradientEndColor">#14181F</Color>
</ResourceDictionary>
