<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Palette only. Shared templates live in ControlStyles.xaml. WPF uses ARGB. -->
    <SolidColorBrush x:Key="SidebarBg" Color="#F7F8FC"/>
    <SolidColorBrush x:Key="ContentBg" Color="#EDF0F6"/>
    <SolidColorBrush x:Key="ContentBgAlt" Color="#F4F6FA"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBgAlt" Color="#F4F6FA"/>
    <SolidColorBrush x:Key="AccentColor" Color="#5744B8"/>
    <SolidColorBrush x:Key="AccentHover" Color="#4935A5"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#1B2433"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#526075"/>
    <SolidColorBrush x:Key="GpuColor" Color="#087859"/>
    <SolidColorBrush x:Key="CpuColor" Color="#5744B8"/>
    <SolidColorBrush x:Key="RamColor" Color="#835A09"/>
    <SolidColorBrush x:Key="SuccessColor" Color="#087859"/>
    <SolidColorBrush x:Key="WarningColor" Color="#835A09"/>
    <SolidColorBrush x:Key="DangerColor" Color="#B72F45"/>
    <SolidColorBrush x:Key="BorderColor" Color="#CED5E1"/>
    <SolidColorBrush x:Key="TitleBarBg" Color="#F7F8FC"/>
    <SolidColorBrush x:Key="NavHoverBg" Color="#E7EAF3"/>
    <SolidColorBrush x:Key="NavCheckedBg" Color="#E7E2FA"/>
    <SolidColorBrush x:Key="ButtonSecondaryBg" Color="#E9EDF5"/>
    <SolidColorBrush x:Key="ButtonSecondaryHover" Color="#DCE2ED"/>
    <SolidColorBrush x:Key="WindowGradientStart" Color="#EDF0F6"/>
    <SolidColorBrush x:Key="WindowGradientEnd" Color="#F7F8FC"/>
    <SolidColorBrush x:Key="NavCheckedText" Color="#49359C"/>
    <SolidColorBrush x:Key="FocusColor" Color="#5744B8"/>
    <SolidColorBrush x:Key="ActionBg" Color="#6554C0"/>
    <SolidColorBrush x:Key="ActionHover" Color="#5643AB"/>
    <SolidColorBrush x:Key="DangerButtonBg" Color="#B92E45"/>
    <SolidColorBrush x:Key="DangerButtonHover" Color="#A32238"/>
    <!-- Severity / category palette consumed by code-behind via SeverityPalette. -->
    <SolidColorBrush x:Key="SeverityCritical" Color="#B72F45"/>
    <SolidColorBrush x:Key="SeverityHigh" Color="#835A09"/>
    <SolidColorBrush x:Key="SeverityMedium" Color="#5744B8"/>
    <SolidColorBrush x:Key="SeverityLow" Color="#526075"/>
    <SolidColorBrush x:Key="SeverityInfo" Color="#087859"/>
    <SolidColorBrush x:Key="SeverityNeutral" Color="#526075"/>
    <!-- Icon tile tints. WPF hex is #AARRGGBB: the alpha byte leads. -->
    <SolidColorBrush x:Key="CpuTint" Color="#1F5744B8"/>
    <SolidColorBrush x:Key="GpuTint" Color="#1F087859"/>
    <SolidColorBrush x:Key="RamTint" Color="#1F835A09"/>
    <SolidColorBrush x:Key="WarningTint" Color="#1F835A09"/>
    <!-- Text placed on a saturated accent/severity fill, not on a surface.
         This theme's fills are deep (#5744B8, #087859, #835A09, #B72F45), so white
         text measures 5.5-7.2:1. The dark theme uses near-black here instead, because
         its fills are pastel - the two themes intentionally differ on this key. -->
    <SolidColorBrush x:Key="OnAccentText" Color="#FFFFFF"/>
    <Color x:Key="WindowGradientStartColor">#EDF0F6</Color>
    <Color x:Key="WindowGradientEndColor">#F7F8FC</Color>
</ResourceDictionary>
