<UserControl x:Class="CrashScope.Desktop.Pages.AgentMonitorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <CollectionViewSource x:Key="GroupedRows" Source="{Binding Rows}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="HardwareName"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Agent Monitor"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Text="Live sensors and recorder status from the agent's RPC control plane (connects to CrashScope.Agent, not the in-process recorder)"
                       FontSize="13"
                       Foreground="{StaticResource TextSecondary}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Connection bar -->
        <Border Grid.Row="1" Background="{StaticResource CardBg}"
                CornerRadius="8" Padding="8,6" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="State dir:" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="4,0,6,0"/>
                <TextBox x:Name="StateDirBox" Width="330" Height="26" FontSize="12"
                         VerticalContentAlignment="Center"/>
                <Button x:Name="ConnectButton" Content="&#xE895;  Connect" ContentTemplate="{StaticResource IconTextTemplate}"
                        FontSize="12" Style="{StaticResource SecondaryButton}"
                        Height="26" Width="94" Margin="8,0,0,0"
                        Click="ConnectButton_Click"/>
                <Button x:Name="DisconnectButton" Content="&#xE8F4;  Stop client" ContentTemplate="{StaticResource IconTextTemplate}"
                        FontSize="12" Style="{StaticResource SecondaryButton}"
                        Height="26" Width="110" Margin="6,0,0,0"
                        Click="DisconnectButton_Click"/>
                <Button x:Name="StartRecButton" Content="&#xE768;  Start" ContentTemplate="{StaticResource IconTextTemplate}"
                        FontSize="12" Style="{StaticResource SecondaryButton}"
                        Height="26" Width="80" Margin="6,0,0,0"
                        Click="StartButton_Click"/>
                <Button x:Name="StopRecButton" Content="&#xE71A;  Stop rec" ContentTemplate="{StaticResource IconTextTemplate}"
                        FontSize="12" Style="{StaticResource SecondaryButton}"
                        Height="26" Width="92" Margin="6,0,0,0"
                        Click="StopButton_Click"/>
                <TextBlock x:Name="ConnectionText" Text="Not connected"
                           VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource TextSecondary}" Margin="14,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Status strip -->
        <Border Grid.Row="2" Background="{StaticResource CardBg}"
                CornerRadius="8" Padding="14,8" Margin="0,0,0,12">
            <WrapPanel>
                <TextBlock x:Name="RecordingText" Text="&#x25CF; idle" FontSize="13"
                           Foreground="{StaticResource TextSecondary}" Margin="0,0,24,0"/>
                <TextBlock x:Name="SamplesText" Text="Samples: 0" FontSize="13"
                           Foreground="{StaticResource TextSecondary}" Margin="0,0,24,0"/>
                <TextBlock x:Name="UptimeText" Text="Uptime: 0 s" FontSize="13"
                           Foreground="{StaticResource TextSecondary}" Margin="0,0,24,0"/>
                <TextBlock x:Name="GpuText" Text="GPU: n/a" FontSize="13"
                           Foreground="{StaticResource TextSecondary}" Margin="0,0,24,0"/>
                <TextBlock x:Name="VersionText" Text="Agent: n/a" FontSize="13"
                           Foreground="{StaticResource TextSecondary}" Margin="0,0,24,0"/>
                <TextBlock x:Name="SessionText" Text="Session: -" FontSize="13"
                           Foreground="{StaticResource TextSecondary}" Margin="0,0,24,0"/>
                <TextBlock x:Name="LastUpdateText" Text="" FontSize="13"
                           Foreground="{StaticResource TextSecondary}"/>
            </WrapPanel>
        </Border>

        <!-- Live sensors -->
        <Border Grid.Row="3" Background="{StaticResource CardBg}"
                CornerRadius="12" Padding="12">
            <ListBox x:Name="SensorList"
                     ItemsSource="{Binding Source={StaticResource GroupedRows}}"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{StaticResource TextPrimary}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" Margin="0,8,0,4"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SensorName}" FontSize="12"
                                       Foreground="{StaticResource TextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding SensorType}" FontSize="11"
                                       Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontSize="12"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontFamily="Consolas"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
