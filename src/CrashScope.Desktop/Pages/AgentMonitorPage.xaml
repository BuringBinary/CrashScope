<UserControl x:Class="CrashScope.Desktop.Pages.AgentMonitorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <CollectionViewSource x:Key="GroupedRows" Source="{Binding Rows}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="HardwareName"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="{DynamicResource L.agentMonitor.title}"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="{DynamicResource L.agentMonitor.subtitle}"
                       FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Connection bar -->
        <Border Grid.Row="1" Background="{DynamicResource CardBg}"
                CornerRadius="8" Padding="8,6" Margin="0,0,0,12">
            <StackPanel>
                <WrapPanel>
                <TextBlock Text="{DynamicResource L.common.stateDir}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="4,0,6,0"/>
                <TextBox x:Name="StateDirBox" Width="330" Height="26" FontSize="12"
                         VerticalContentAlignment="Center"/>
                <Button x:Name="ConnectButton" Content="{DynamicResource L.common.connect}" ContentTemplate="{StaticResource IconTextTemplate}"
                        FontSize="12" Style="{StaticResource SecondaryButton}"
                        Height="26" MinWidth="94" Margin="8,0,0,0"
                        Click="ConnectButton_Click"/>
                <Button x:Name="DisconnectButton" Content="{DynamicResource L.agentMonitor.stopClient}" ContentTemplate="{StaticResource IconTextTemplate}"
                        FontSize="12" Style="{StaticResource SecondaryButton}"
                        Height="26" MinWidth="110" Margin="6,0,0,0"
                        Click="DisconnectButton_Click"/>
                <Button x:Name="StartRecButton" Content="{DynamicResource L.common.start}" ContentTemplate="{StaticResource IconTextTemplate}"
                        FontSize="12" Style="{StaticResource SecondaryButton}"
                        Height="26" MinWidth="80" Margin="6,0,0,0"
                        Click="StartButton_Click"/>
                <Button x:Name="StopRecButton" Content="{DynamicResource L.agentMonitor.stopRec}" ContentTemplate="{StaticResource IconTextTemplate}"
                        FontSize="12" Style="{StaticResource SecondaryButton}"
                        Height="26" MinWidth="92" Margin="6,0,0,0"
                        Click="StopButton_Click"/>
                </WrapPanel>
                <TextBox x:Name="ConnectionText" Text="{DynamicResource L.common.notConnected}"
                         IsReadOnly="True" TextWrapping="Wrap" MaxHeight="64"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                         BorderThickness="0" Background="Transparent" Padding="0"
                         Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="4,8,4,0"/>
            </StackPanel>
        </Border>

        <!-- Status strip -->
        <Border Grid.Row="2" Background="{DynamicResource CardBg}"
                CornerRadius="8" Padding="14,8" Margin="0,0,0,12">
            <WrapPanel>
                <TextBlock x:Name="RecordingText" Text="{DynamicResource L.agentMonitor.idleDot}" FontSize="13"
                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,24,0"/>
                <TextBlock x:Name="SamplesText" Text="{DynamicResource L.home.samplesPlaceholder}" FontSize="13"
                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,24,0"/>
                <TextBlock x:Name="UptimeText" Text="{DynamicResource L.agentMonitor.uptimePlaceholder}" FontSize="13"
                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,24,0"/>
                <TextBlock x:Name="GpuText" Text="{DynamicResource L.agentMonitor.gpuPlaceholder}" FontSize="13"
                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,24,0"/>
                <TextBlock x:Name="VersionText" Text="{DynamicResource L.agentMonitor.agentPlaceholder}" FontSize="13"
                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,24,0"/>
                <TextBlock x:Name="SessionText" Text="{DynamicResource L.agentMonitor.sessionPlaceholder}" FontSize="13"
                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,24,0"/>
                <TextBlock x:Name="LastUpdateText" Text="" FontSize="13"
                           Foreground="{DynamicResource TextSecondary}"/>
            </WrapPanel>
        </Border>

        <!-- Live sensors -->
        <Border Grid.Row="3" Background="{DynamicResource CardBg}"
                CornerRadius="12" Padding="12">
            <ListBox x:Name="SensorList"
                     ItemsSource="{Binding Source={StaticResource GroupedRows}}"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{DynamicResource TextPrimary}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,8,0,4"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SensorName}" FontSize="12"
                                       Foreground="{DynamicResource TextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding SensorType}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontSize="12"
                                       Foreground="{DynamicResource TextPrimary}"
                                       FontFamily="Consolas"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>

