<UserControl x:Class="CrashScope.Desktop.Pages.IncidentsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Incidents"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Text="Past crash incidents detected by the flight recorder"
                       FontSize="13"
                       Foreground="{StaticResource TextSecondary}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Summary bar -->
        <Border Grid.Row="1" Background="{StaticResource CardBg}"
                CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Total Incidents" FontSize="11"
                               Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock x:Name="TotalIncidentsText" Text="0"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Last Incident" FontSize="11"
                               Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock x:Name="LastIncidentText" Text="--"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Top Cause" FontSize="11"
                               Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock x:Name="TopCauseText" Text="--"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource AccentColor}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Incident list -->
        <Border Grid.Row="2" Background="{StaticResource CardBg}"
                CornerRadius="12" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: incident list -->
                <ListBox x:Name="IncidentListBox"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource TextPrimary}"
                         SelectionChanged="IncidentListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0F0F1A" CornerRadius="8"
                                    Padding="12" Margin="0,0,8,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding Timestamp}" FontSize="12"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontFamily="Consolas"/>
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Border CornerRadius="4" Padding="4,2"
                                                Background="{Binding ModeBackground}">
                                            <TextBlock Text="{Binding Mode}" FontSize="10"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Confidence}" FontSize="10"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Right: incident detail -->
                <Border Grid.Column="1" Background="#0F0F1A"
                        CornerRadius="8" Padding="20" Margin="8,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                            <TextBlock x:Name="DetailTitle" Text="Select an incident"
                                       FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       Margin="0,0,0,16"/>

                            <TextBlock Text="Hypotheses" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,0,0,8"/>
                            <ItemsControl x:Name="HypothesesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBg}"
                                                CornerRadius="6" Padding="10" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                           Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ScoreDisplay}"
                                                           FontSize="12" FontWeight="Bold"
                                                           Foreground="{StaticResource AccentColor}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Open Questions"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,16,0,8"/>
                            <ItemsControl x:Name="QuestionsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource WarningColor}"
                                                   Margin="0,0,0,4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Export button bar -->
                    <Border Grid.Row="1"
                            BorderBrush="{StaticResource CardBg}"
                            BorderThickness="0,1,0,0"
                            Padding="0,12,0,0"
                            Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="RedactCheckBox"
                                      Content="Redact personal data"
                                      IsChecked="True"
                                      Foreground="{StaticResource TextSecondary}"
                                      FontSize="11"
                                      VerticalAlignment="Center"
                                      Margin="0,0,12,0"/>
                            <Button x:Name="ExportButton"
                                    Content="&#xE74C;  Export Diagnostic ZIP"
                                    Height="34" FontSize="12"
                                    Style="{StaticResource AccentButton}"
                                    Click="ExportButton_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>