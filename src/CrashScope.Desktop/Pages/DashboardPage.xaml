<UserControl x:Class="CrashScope.Desktop.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="Hardware Dashboard"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}"
                       Margin="0,0,0,8"/>
            <TextBlock Text="Real-time CPU, GPU and memory telemetry with GPU state transition detection"
                       FontSize="13"
                       Foreground="{StaticResource TextSecondary}"
                       Margin="0,0,0,24"/>

            <!-- Top row: CPU / GPU / RAM cards -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CPU Card -->
                <Border Grid.Column="0" Background="{StaticResource CardBg}"
                        CornerRadius="12" Padding="20" Margin="0,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="#FF6B6B22" CornerRadius="6" Width="32" Height="32" Margin="0,0,10,0">
                                <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="16" Foreground="{StaticResource CpuColor}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="CPU" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock x:Name="CpuModelText" Text="Detecting..."
                                           FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CpuLoadText" Text="--"
                                       FontSize="36" FontWeight="Bold"
                                       Foreground="{StaticResource CpuColor}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="% Load"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Temp" FontSize="10"
                                           Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="CpuTempText" Text="--°C"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Clock" FontSize="10"
                                           Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="CpuClockText" Text="-- MHz"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- GPU Card -->
                <Border Grid.Column="1" Background="{StaticResource CardBg}"
                        CornerRadius="12" Padding="20" Margin="4,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="#00D68F22" CornerRadius="6" Width="32" Height="32" Margin="0,0,10,0">
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="16" Foreground="{StaticResource GpuColor}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="GPU" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock x:Name="GpuModelText" Text="Detecting..."
                                           FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="GpuLoadText" Text="--"
                                       FontSize="36" FontWeight="Bold"
                                       Foreground="{StaticResource GpuColor}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="% Load"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Temp" FontSize="10"
                                           Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="GpuTempText" Text="--°C"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Text="Clock" FontSize="10"
                                           Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="GpuClockText" Text="-- MHz"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="VRAM" FontSize="10"
                                           Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="GpuVramText" Text="-- GB"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Text="Power" FontSize="10"
                                           Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="GpuPowerText" Text="-- W"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- RAM Card -->
                <Border Grid.Column="2" Background="{StaticResource CardBg}"
                        CornerRadius="12" Padding="20" Margin="8,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Background="#FFD93D22" CornerRadius="6" Width="32" Height="32" Margin="0,0,10,0">
                                <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="16" Foreground="{StaticResource RamColor}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="RAM" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock x:Name="RamTotalText" Text="-- GB"
                                           FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RamUsedText" Text="--"
                                       FontSize="36" FontWeight="Bold"
                                       Foreground="{StaticResource RamColor}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="GB Used"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Available" FontSize="10"
                                           Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="RamAvailText" Text="-- GB"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Usage" FontSize="10"
                                           Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="RamPercentText" Text="--%"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- GPU Engines -->
            <Border Background="{StaticResource CardBg}"
                    CornerRadius="12" Padding="20" Margin="0,0,0,16"
                    x:Name="GpuEnginesPanel" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Background="#00D68F22" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Foreground="{StaticResource GpuColor}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="GPU Engines"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock x:Name="GpuEnginesTimestamp"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ItemsControl x:Name="GpuEnginesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding EngineType}"
                                               FontSize="12" Foreground="{StaticResource TextSecondary}"
                                               VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Height="20" CornerRadius="4"
                                            Background="#0F0F1A" Margin="8,0">
                                        <Border CornerRadius="4"
                                                Background="{StaticResource GpuColor}"
                                                Width="{Binding BarWidth}"
                                                HorizontalAlignment="Left"
                                                Opacity="{Binding BarOpacity}"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding DisplayPercent}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- GPU State Transitions -->
            <Border Background="{StaticResource CardBg}"
                    CornerRadius="12" Padding="20" Margin="0,0,0,16"
                    x:Name="GpuTransitionsPanel" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Background="#FFD93D22" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Foreground="{StaticResource WarningColor}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="GPU State Transitions"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Real-time detection of GPU load, clock, and power changes"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                        <Button x:Name="ClearTransitionsButton"
                                Content="&#xE777;  Clear"
                                FontSize="11"
                                Style="{StaticResource SecondaryButton}"
                                Height="24" Width="60"
                                HorizontalAlignment="Right"
                                Margin="12,0,0,0"
                                Click="ClearTransitionsButton_Click"/>
                    </StackPanel>
                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="GpuTransitionsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0F0F1A" CornerRadius="6" Padding="10,8" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="3" CornerRadius="2"
                                                    Background="{Binding MarkerColor}"
                                                    VerticalAlignment="Stretch"
                                                    Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Timestamp}"
                                                       FontSize="11" FontFamily="Consolas"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding SensorLabel}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{Binding MarkerColor}"/>
                                                <TextBlock Text="{Binding TransitionDetail}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- History Charts -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="240"/>
                    <RowDefinition Height="240"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                           Text="History Charts"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           Margin="0,0,0,8"/>

                <Border Grid.Row="1" Grid.Column="0"
                        Background="{StaticResource CardBg}"
                        CornerRadius="12" Padding="12" Margin="0,0,8,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="CPU Load %"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource CpuColor}"
                                   Margin="0,0,0,4"/>
                        <oxy:PlotView Grid.Row="1" x:Name="CpuChart"
                                      Background="Transparent"
                                      Foreground="{StaticResource TextSecondary}"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="1"
                        Background="{StaticResource CardBg}"
                        CornerRadius="12" Padding="12" Margin="8,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="GPU Load %"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource GpuColor}"
                                   Margin="0,0,0,4"/>
                        <oxy:PlotView Grid.Row="1" x:Name="GpuChart"
                                      Background="Transparent"
                                      Foreground="{StaticResource TextSecondary}"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.Column="0"
                        Background="{StaticResource CardBg}"
                        CornerRadius="12" Padding="12" Margin="0,8,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="GPU Clock (MHz) / Power (W)"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource GpuColor}"
                                   Margin="0,0,0,4"/>
                        <oxy:PlotView Grid.Row="1" x:Name="GpuClockPowerChart"
                                      Background="Transparent"
                                      Foreground="{StaticResource TextSecondary}"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.Column="1"
                        Background="{StaticResource CardBg}"
                        CornerRadius="12" Padding="12" Margin="8,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="RAM Usage (GB)"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource RamColor}"
                                   Margin="0,0,0,4"/>
                        <oxy:PlotView Grid.Row="1" x:Name="RamChart"
                                      Background="Transparent"
                                      Foreground="{StaticResource TextSecondary}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Sensor Details -->
            <Border Background="{StaticResource CardBg}"
                    CornerRadius="12" Padding="24">
                <StackPanel>
                    <TextBlock Text="Sensor Details"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,12"/>
                    <ItemsControl x:Name="SensorList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0F0F1A" CornerRadius="6" Padding="10,8" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="12"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Value}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>