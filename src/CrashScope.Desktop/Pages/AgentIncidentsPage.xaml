<UserControl x:Class="CrashScope.Desktop.Pages.AgentIncidentsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="{DynamicResource L.agentIncidents.title}"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="{DynamicResource L.agentIncidents.subtitle}"
                       FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Connection bar -->
        <Border Grid.Row="1" Background="{DynamicResource CardBg}"
                CornerRadius="8" Padding="8,6" Margin="0,0,0,12">
            <StackPanel>
                <WrapPanel>
                <TextBlock Text="{DynamicResource L.common.stateDir}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="4,0,6,0"/>
                <TextBox x:Name="StateDirBox" Width="330" Height="26" FontSize="12"
                         VerticalContentAlignment="Center"/>
                <Button x:Name="ConnectButton" Content="{DynamicResource L.common.refresh}" ContentTemplate="{StaticResource IconTextTemplate}"
                        FontSize="12" Style="{StaticResource SecondaryButton}"
                        Height="26" MinWidth="96" Margin="8,0,0,0"
                        Click="RefreshButton_Click"/>
                </WrapPanel>
                <TextBox x:Name="ConnectionText" Text="{DynamicResource L.common.notConnected}"
                         IsReadOnly="True" TextWrapping="Wrap" MaxHeight="64"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                         BorderThickness="0" Background="Transparent" Padding="0"
                         Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="4,8,4,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Incident list -->
            <Border Grid.Column="0" Background="{DynamicResource CardBg}"
                    CornerRadius="12" Padding="8" Margin="0,0,12,0">
                <ListBox x:Name="IncidentList"
                         ItemsSource="{Binding Incidents}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource TextPrimary}"
                         SelectionChanged="IncidentList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBgAlt}" CornerRadius="6"
                                    Padding="10,6" Margin="0,0,0,4">
                                <StackPanel>
                                    <TextBlock Text="{Binding Timestamp}" FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}"
                                               FontFamily="Consolas"/>
                                    <TextBlock Text="{Binding LeadingMode}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Text="{Binding Confidence, StringFormat=saved heuristic support {0:P0}}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Detail -->
            <Border Grid.Column="1" Background="{DynamicResource CardBg}"
                    CornerRadius="12" Padding="12">
                <TextBox x:Name="DetailBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource TextPrimary}"
                         FontFamily="Consolas" FontSize="12"
                         IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>

