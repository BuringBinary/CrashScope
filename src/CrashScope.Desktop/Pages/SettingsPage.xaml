<UserControl x:Class="CrashScope.Desktop.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="{DynamicResource L.settings.title}"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}"
                       Margin="0,0,0,8"/>
            <TextBlock Text="{DynamicResource L.settings.subtitle}"
                       FontSize="13"
                       Foreground="{StaticResource TextSecondary}"
                       Margin="0,0,0,24"/>

            <!-- Appearance -->
            <Border Background="{StaticResource CardBg}"
                    CornerRadius="12" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.settings.appearance.title}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource L.settings.appearance.subtitle}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Language -->
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="{DynamicResource L.settings.appearance.language}"
                                       FontSize="13" Foreground="{StaticResource TextPrimary}"
                                       Margin="0,0,0,6"/>
                            <ComboBox x:Name="LanguageComboBox"
                                      Width="200"
                                      SelectionChanged="LanguageComboBox_SelectionChanged"/>
                        </StackPanel>

                        <!-- Theme -->
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="{DynamicResource L.settings.appearance.theme}"
                                       FontSize="13" Foreground="{StaticResource TextPrimary}"
                                       Margin="0,0,0,6"/>
                            <ComboBox x:Name="ThemeComboBox"
                                      Width="200"
                                      SelectionChanged="ThemeComboBox_SelectionChanged"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>


            <!-- Startup & Tray -->
            <Border Background="{StaticResource CardBg}"
                    CornerRadius="12" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.settings.startup.title}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource L.settings.startup.subtitle}" FontSize="12"
                               Foreground="{StaticResource TextSecondary}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                    <CheckBox x:Name="AutoStartCheckBox" Content="{DynamicResource L.settings.startup.autoStart}"
                              Foreground="{StaticResource TextPrimary}" FontSize="13" Margin="0,0,0,8"
                              Checked="AutoStartCheckBox_Changed" Unchecked="AutoStartCheckBox_Changed"/>
                    <TextBlock Text="{DynamicResource L.settings.startup.autoStartHint}" FontSize="11"
                               Foreground="{StaticResource TextSecondary}" Margin="24,0,0,12" TextWrapping="Wrap"/>

                    <CheckBox x:Name="MinimizeToTrayCheckBox" Content="{DynamicResource L.settings.startup.minimizeToTray}"
                              Foreground="{StaticResource TextPrimary}" FontSize="13" Margin="0,0,0,8"
                              Checked="TrayBehaviourCheckBox_Changed" Unchecked="TrayBehaviourCheckBox_Changed"/>
                    <CheckBox x:Name="CloseToTrayCheckBox" Content="{DynamicResource L.settings.startup.closeToTray}"
                              Foreground="{StaticResource TextPrimary}" FontSize="13" Margin="0,0,0,12"
                              Checked="TrayBehaviourCheckBox_Changed" Unchecked="TrayBehaviourCheckBox_Changed"/>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{DynamicResource L.settings.startup.openDataDir}" Width="120" Height="32" FontSize="12"
                                Style="{StaticResource SecondaryButton}" Click="OpenDataFolder_Click" Margin="0,0,8,0"/>
                        <Button Content="{DynamicResource L.settings.startup.openIncidentsDir}" Width="120" Height="32" FontSize="12"
                                Style="{StaticResource SecondaryButton}" Click="OpenIncidentsFolder_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="RecoveryPendingText" Text="" FontSize="11"
                               Foreground="#FFD93D" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Retention -->

            <Border Background="{StaticResource CardBg}"
                    CornerRadius="12" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.settings.dataRetention.title}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource L.settings.dataRetention.subtitle}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,0,0,16"/>

                    <!-- Max Retention Days -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource L.settings.dataRetention.maxRetentionDays}"
                                   FontSize="13" Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                        <Slider x:Name="RetentionDaysSlider"
                                Grid.Column="1"
                                Minimum="1" Maximum="90" TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Value="30"
                                ValueChanged="RetentionDaysSlider_ValueChanged"
                                Margin="8,0"/>
                        <TextBlock x:Name="RetentionDaysText"
                                   Grid.Column="2"
                                   Text="30 days"
                                   FontSize="13" Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Max Total Size -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource L.settings.dataRetention.maxTotalSize}"
                                   FontSize="13" Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                        <Slider x:Name="MaxSizeSlider"
                                Grid.Column="1"
                                Minimum="64" Maximum="4096" TickFrequency="64"
                                IsSnapToTickEnabled="True"
                                Value="512"
                                ValueChanged="MaxSizeSlider_ValueChanged"
                                Margin="8,0"/>
                        <TextBlock x:Name="MaxSizeText"
                                   Grid.Column="2"
                                   Text="512 MB"
                                   FontSize="13" Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Current Usage -->
                    <Border Background="#0F0F1A" CornerRadius="8" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource L.settings.dataRetention.currentUsage}"
                                       FontSize="12" Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="CurrentUsageText"
                                       Grid.Column="1"
                                       Text="{DynamicResource L.common.calculating}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentColor}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Privacy -->
            <Border Background="{StaticResource CardBg}"
                    CornerRadius="12" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.settings.privacy.title}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource L.settings.privacy.subtitle}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,0,0,16"
                               TextWrapping="Wrap"/>

                    <Border Background="#0F0F1A" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <CheckBox x:Name="RedactByDefaultCheckBox"
                                      Content="{DynamicResource L.settings.privacy.redactByDefault}"
                                      Foreground="{StaticResource TextPrimary}"
                                      FontSize="13"/>
                            <TextBlock Text="{DynamicResource L.settings.privacy.redactDesc}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="24,4,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Recording -->
            <Border Background="{StaticResource CardBg}"
                    CornerRadius="12" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.settings.recording.title}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="#0F0F1A" CornerRadius="8" Padding="10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L.common.telemetry}"
                                           FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="1 Hz"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentColor}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0F0F1A" CornerRadius="8" Padding="10" Margin="3,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L.common.processes}"
                                           FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="0.5 Hz"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentColor}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0F0F1A" CornerRadius="8" Padding="10" Margin="3,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L.common.gpuEngines}"
                                           FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="0.5 Hz"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentColor}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0F0F1A" CornerRadius="8" Padding="10" Margin="3,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L.common.display}"
                                           FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="0.2 Hz"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentColor}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0F0F1A" CornerRadius="8" Padding="10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L.common.snapshot}"
                                           FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="1/30 Hz"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentColor}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Background="{StaticResource CardBg}"
                    CornerRadius="12" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.settings.about.title}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{DynamicResource L.settings.about.version}" Grid.Row="0" Grid.Column="0"
                                   FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="v0.5.0-dev" Grid.Row="0" Grid.Column="1"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"/>

                        <TextBlock Text="{DynamicResource L.settings.about.dataDir}" Grid.Row="1" Grid.Column="0"
                                   FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                            <TextBlock x:Name="DataDirText"
                                       FontSize="13"
                                       Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="380"/>
                            <Button Content="&#xE8C8;"
                                    ContentTemplate="{StaticResource IconTextTemplate}"
                                    Width="28" Height="24"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0"
                                    Click="CopyDataDir_Click"
                                    ToolTip="{DynamicResource L.settings.about.copyPath}"/>
                        </StackPanel>

                        <TextBlock Text="{DynamicResource L.settings.about.runtime}" Grid.Row="2" Grid.Column="0"
                                   FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock x:Name="RuntimeText" Grid.Row="2" Grid.Column="1"
                                   Text=".NET 8.0"
                                   FontSize="13"
                                   Foreground="{StaticResource TextPrimary}"/>

                        <TextBlock Text="{DynamicResource L.settings.about.elevation}" Grid.Row="3" Grid.Column="0"
                                   FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock x:Name="ElevationText" Grid.Row="3" Grid.Column="1"
                                   Text="{DynamicResource L.common.checking}"
                                   FontSize="13"
                                   Foreground="{StaticResource TextPrimary}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Save Button + Status -->
            <Grid HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SaveStatusText"
                           FontSize="13"
                           Foreground="{StaticResource GpuColor}"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"
                           Visibility="Collapsed"/>
                <Button x:Name="SaveButton"
                        Grid.Column="1"
                        Content="{DynamicResource L.settings.buttons.saveSettings}"
                        Height="40" Width="180"
                        FontSize="14"
                        Style="{StaticResource AccentButton}"
                        Click="SaveButton_Click"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>