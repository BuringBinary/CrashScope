<UserControl x:Class="CrashScope.Desktop.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="Settings"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}"
                       Margin="0,0,0,8"/>
            <TextBlock Text="Configure recording, retention, and privacy"
                       FontSize="13"
                       Foreground="{StaticResource TextSecondary}"
                       Margin="0,0,0,24"/>

            <!-- Appearance -->
            <Border Background="{StaticResource CardBg}"
                    CornerRadius="12" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Appearance"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Customize language and visual theme"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Language -->
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Language"
                                       FontSize="13" Foreground="{StaticResource TextPrimary}"
                                       Margin="0,0,0,6"/>
                            <ComboBox x:Name="LanguageComboBox"
                                      Width="200"
                                      SelectionChanged="LanguageComboBox_SelectionChanged"/>
                        </StackPanel>

                        <!-- Theme -->
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="Theme"
                                       FontSize="13" Foreground="{StaticResource TextPrimary}"
                                       Margin="0,0,0,6"/>
                            <ComboBox x:Name="ThemeComboBox"
                                      Width="200"
                                      SelectionChanged="ThemeComboBox_SelectionChanged"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>


            <!-- Startup & Tray -->
            <Border Background="{StaticResource CardBg}"
                    CornerRadius="12" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Startup &amp; Tray" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock Text="开机启动和托盘行为，默认不修改系统，仅当前用户" FontSize="12"
                               Foreground="{StaticResource TextSecondary}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                    <CheckBox x:Name="AutoStartCheckBox" Content="开机自动启动（当前用户注册表 Run）"
                              Foreground="{StaticResource TextPrimary}" FontSize="13" Margin="0,0,0,8"
                              Checked="AutoStartCheckBox_Changed" Unchecked="AutoStartCheckBox_Changed"/>
                    <TextBlock Text="仅启动 Desktop，不自动开始录制；录制需手动开始或由 Agent 负责" FontSize="11"
                               Foreground="{StaticResource TextSecondary}" Margin="24,0,0,12" TextWrapping="Wrap"/>

                    <CheckBox x:Name="MinimizeToTrayCheckBox" Content="最小化时隐藏到托盘（默认最小化到任务栏）"
                              Foreground="{StaticResource TextPrimary}" FontSize="13" Margin="0,0,0,8"
                              Checked="TrayBehaviourCheckBox_Changed" Unchecked="TrayBehaviourCheckBox_Changed"/>
                    <CheckBox x:Name="CloseToTrayCheckBox" Content="关闭时最小化到托盘而非退出"
                              Foreground="{StaticResource TextPrimary}" FontSize="13" Margin="0,0,0,12"
                              Checked="TrayBehaviourCheckBox_Changed" Unchecked="TrayBehaviourCheckBox_Changed"/>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="打开数据目录" Width="120" Height="32" FontSize="12"
                                Style="{StaticResource SecondaryButton}" Click="OpenDataFolder_Click" Margin="0,0,8,0"/>
                        <Button Content="打开故障目录" Width="120" Height="32" FontSize="12"
                                Style="{StaticResource SecondaryButton}" Click="OpenIncidentsFolder_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="RecoveryPendingText" Text="" FontSize="11"
                               Foreground="#FFD93D" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Retention -->

            <Border Background="{StaticResource CardBg}"
                    CornerRadius="12" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Data Retention"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Control how long session and incident data is kept"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,0,0,16"/>

                    <!-- Max Retention Days -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Max retention days"
                                   FontSize="13" Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                        <Slider x:Name="RetentionDaysSlider"
                                Grid.Column="1"
                                Minimum="1" Maximum="90" TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Value="30"
                                ValueChanged="RetentionDaysSlider_ValueChanged"
                                Margin="8,0"/>
                        <TextBlock x:Name="RetentionDaysText"
                                   Grid.Column="2"
                                   Text="30 days"
                                   FontSize="13" Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Max Total Size -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Max total size"
                                   FontSize="13" Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                        <Slider x:Name="MaxSizeSlider"
                                Grid.Column="1"
                                Minimum="64" Maximum="4096" TickFrequency="64"
                                IsSnapToTickEnabled="True"
                                Value="512"
                                ValueChanged="MaxSizeSlider_ValueChanged"
                                Margin="8,0"/>
                        <TextBlock x:Name="MaxSizeText"
                                   Grid.Column="2"
                                   Text="512 MB"
                                   FontSize="13" Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Current Usage -->
                    <Border Background="#0F0F1A" CornerRadius="8" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Current usage:"
                                       FontSize="12" Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="CurrentUsageText"
                                       Grid.Column="1"
                                       Text="Calculating..."
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentColor}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Privacy -->
            <Border Background="{StaticResource CardBg}"
                    CornerRadius="12" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Privacy"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="CrashScope intentionally avoids collecting command lines, window titles, screenshots, or network data"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,0,0,16"
                               TextWrapping="Wrap"/>

                    <Border Background="#0F0F1A" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <CheckBox x:Name="RedactByDefaultCheckBox"
                                      Content="Redact personal data by default on export"
                                      Foreground="{StaticResource TextPrimary}"
                                      FontSize="13"/>
                            <TextBlock Text="Process names, window titles, user names, and file paths are anonymized in exported ZIP files"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="24,4,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Recording -->
            <Border Background="{StaticResource CardBg}"
                    CornerRadius="12" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Recording"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="#0F0F1A" CornerRadius="8" Padding="10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Telemetry"
                                           FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="1 Hz"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentColor}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0F0F1A" CornerRadius="8" Padding="10" Margin="3,0">
                            <StackPanel>
                                <TextBlock Text="Processes"
                                           FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="0.5 Hz"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentColor}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0F0F1A" CornerRadius="8" Padding="10" Margin="3,0">
                            <StackPanel>
                                <TextBlock Text="GPU Engines"
                                           FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="0.5 Hz"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentColor}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0F0F1A" CornerRadius="8" Padding="10" Margin="3,0">
                            <StackPanel>
                                <TextBlock Text="Display"
                                           FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="0.2 Hz"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentColor}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0F0F1A" CornerRadius="8" Padding="10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Snapshot"
                                           FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="1/30 Hz"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentColor}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Background="{StaticResource CardBg}"
                    CornerRadius="12" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="About"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Version" Grid.Row="0" Grid.Column="0"
                                   FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Text="v0.5.0-dev" Grid.Row="0" Grid.Column="1"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"/>

                        <TextBlock Text="Data directory" Grid.Row="1" Grid.Column="0"
                                   FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                            <TextBlock x:Name="DataDirText"
                                       FontSize="13"
                                       Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="380"/>
                            <Button Content="&#xE8C8;"
                                    ContentTemplate="{StaticResource IconTextTemplate}"
                                    Width="28" Height="24"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0"
                                    Click="CopyDataDir_Click"
                                    ToolTip="Copy path"/>
                        </StackPanel>

                        <TextBlock Text=".NET Runtime" Grid.Row="2" Grid.Column="0"
                                   FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock x:Name="RuntimeText" Grid.Row="2" Grid.Column="1"
                                   Text=".NET 8.0"
                                   FontSize="13"
                                   Foreground="{StaticResource TextPrimary}"/>

                        <TextBlock Text="Elevation" Grid.Row="3" Grid.Column="0"
                                   FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock x:Name="ElevationText" Grid.Row="3" Grid.Column="1"
                                   Text="Checking..."
                                   FontSize="13"
                                   Foreground="{StaticResource TextPrimary}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Save Button + Status -->
            <Grid HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SaveStatusText"
                           FontSize="13"
                           Foreground="{StaticResource GpuColor}"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"
                           Visibility="Collapsed"/>
                <Button x:Name="SaveButton"
                        Grid.Column="1"
                        Content="&#xE74E;  Save Settings"
                        Height="40" Width="180"
                        FontSize="14"
                        Style="{StaticResource AccentButton}"
                        Click="SaveButton_Click"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>