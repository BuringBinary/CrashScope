<UserControl x:Class="CrashScope.Desktop.Pages.TimelinePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Timeline"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Text="Crash reconstruction timeline: telemetry, processes, GPU transitions, Windows events"
                       FontSize="13"
                       Foreground="{StaticResource TextSecondary}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Legend -->
        <Border Grid.Row="1" Background="{StaticResource CardBg}"
                CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Border Background="{StaticResource AccentColor}"
                        CornerRadius="4" Width="12" Height="12" Margin="0,0,4,0"/>
                <TextBlock Text="Telemetry" Foreground="{StaticResource TextSecondary}"
                           FontSize="11" Margin="0,0,16,0"/>
                <Border Background="{StaticResource GpuColor}"
                        CornerRadius="4" Width="12" Height="12" Margin="0,0,4,0"/>
                <TextBlock Text="GPU Transition" Foreground="{StaticResource TextSecondary}"
                           FontSize="11" Margin="0,0,16,0"/>
                <Border Background="{StaticResource CpuColor}"
                        CornerRadius="4" Width="12" Height="12" Margin="0,0,4,0"/>
                <TextBlock Text="App/Process" Foreground="{StaticResource TextSecondary}"
                           FontSize="11" Margin="0,0,16,0"/>
                <Border Background="{StaticResource RamColor}"
                        CornerRadius="4" Width="12" Height="12" Margin="0,0,4,0"/>
                <TextBlock Text="Windows Event" Foreground="{StaticResource TextSecondary}"
                           FontSize="11" Margin="0,0,16,0"/>
                <Border Background="{StaticResource DangerColor}"
                        CornerRadius="4" Width="12" Height="12" Margin="0,0,4,0"/>
                <TextBlock Text="Crash Point" Foreground="{StaticResource TextSecondary}"
                           FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- Timeline -->
        <Border Grid.Row="2" Background="{StaticResource CardBg}"
                CornerRadius="12" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Time range selector -->
                <Border Grid.Row="0" Background="#0F0F1A" CornerRadius="8"
                        Padding="12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="IncidentSelector"
                                  Grid.Column="0"
                                  Width="280"
                                  Background="#1E1F3A"
                                  Foreground="{StaticResource TextPrimary}"
                                  BorderThickness="0"
                                  SelectionChanged="IncidentSelector_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" FontSize="12"
                                               Foreground="{StaticResource TextPrimary}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock x:Name="TimelineStartText" Grid.Column="1" Text="T-5:00"
                                   FontSize="12" Foreground="{StaticResource TextSecondary}"
                                   FontFamily="Consolas" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" x:Name="TimelineEndText" Text="T+0:00"
                                   FontSize="12" Foreground="{StaticResource DangerColor}"
                                   FontFamily="Consolas"/>
                    </Grid>
                </Border>

                <!-- Timeline entries -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="TimelineList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Time}"
                                               FontSize="11" FontFamily="Consolas"
                                               Foreground="{StaticResource TextSecondary}"
                                               VerticalAlignment="Top" Margin="0,4,0,0"/>

                                    <Grid Grid.Column="1" Width="24" Margin="4,0,8,0">
                                        <Rectangle Width="2"
                                                   Fill="{Binding Color}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Stretch"/>
                                        <Ellipse Width="8" Height="8"
                                                 Fill="{Binding Color}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Top" Margin="0,6,0,0"/>
                                    </Grid>

                                    <Border Grid.Column="2"
                                            Background="#0F0F1A"
                                            CornerRadius="6" Padding="10,8"
                                            Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Category}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentColor}"/>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>