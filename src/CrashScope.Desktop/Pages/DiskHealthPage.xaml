<UserControl x:Class="CrashScope.Desktop.Pages.DiskHealthPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Disk Health" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Text="物理磁盘温度 / SMART / IO 延迟 — 只读展示，数据来自录制会话的存储采集"
                       FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource CardBg}" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource TextSecondary}" Text="No live readings yet."/>
                <TextBlock x:Name="CollectorText" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource CardBg}" CornerRadius="12" Padding="16">
            <ListView x:Name="DiskList" Background="Transparent" BorderThickness="0"
                      Foreground="{StaticResource TextPrimary}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Disk" Width="95" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="Model" Width="165" DisplayMemberBinding="{Binding Model}"/>
                        <GridViewColumn Header="Index" Width="85" DisplayMemberBinding="{Binding IndexText}"/>
                        <GridViewColumn Header="Temp" Width="75" DisplayMemberBinding="{Binding TemperatureText}"/>
                        <GridViewColumn Header="SMART" Width="80" DisplayMemberBinding="{Binding SmartHealthText}"/>
                        <GridViewColumn Header="Disk Time" Width="70" DisplayMemberBinding="{Binding DiskTimeText}"/>
                        <GridViewColumn Header="Read" Width="80" DisplayMemberBinding="{Binding ReadLatencyText}"/>
                        <GridViewColumn Header="Write" Width="80" DisplayMemberBinding="{Binding WriteLatencyText}"/>
                        <GridViewColumn Header="Queue" Width="60" DisplayMemberBinding="{Binding QueueDepthText}"/>
                        <GridViewColumn Header="Sources" Width="170" DisplayMemberBinding="{Binding SourcesText}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource CardBg}" CornerRadius="12" Padding="16" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Volumes (DriveInfo)" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                <TextBlock x:Name="VolumesText" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
