<UserControl x:Class="CrashScope.Desktop.Pages.DiskHealthPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource L.diskHealth.title}" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="{DynamicResource L.diskHealth.subtitle}"
                       FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource CardBg}" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource L.diskHealth.noReadings}"/>
                <TextBlock x:Name="CollectorText" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource CardBg}" CornerRadius="12" Padding="16">
            <ListView x:Name="DiskList" Background="Transparent" BorderThickness="0"
                      Foreground="{DynamicResource TextPrimary}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="{DynamicResource L.common.disk}" Width="95" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="{DynamicResource L.diskHealth.col.model}" Width="165" DisplayMemberBinding="{Binding Model}"/>
                        <GridViewColumn Header="{DynamicResource L.diskHealth.col.index}" Width="85" DisplayMemberBinding="{Binding IndexText}"/>
                        <GridViewColumn Header="{DynamicResource L.common.temp}" Width="75" DisplayMemberBinding="{Binding TemperatureText}"/>
                        <GridViewColumn Header="SMART" Width="80" DisplayMemberBinding="{Binding SmartHealthText}"/>
                        <GridViewColumn Header="{DynamicResource L.diskHealth.col.diskTime}" Width="70" DisplayMemberBinding="{Binding DiskTimeText}"/>
                        <GridViewColumn Header="{DynamicResource L.diskHealth.col.read}" Width="80" DisplayMemberBinding="{Binding ReadLatencyText}"/>
                        <GridViewColumn Header="{DynamicResource L.diskHealth.col.write}" Width="80" DisplayMemberBinding="{Binding WriteLatencyText}"/>
                        <GridViewColumn Header="{DynamicResource L.diskHealth.col.queue}" Width="60" DisplayMemberBinding="{Binding QueueDepthText}"/>
                        <GridViewColumn Header="{DynamicResource L.diskHealth.col.sources}" Width="170" DisplayMemberBinding="{Binding SourcesText}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <Border Grid.Row="3" Background="{DynamicResource CardBg}" CornerRadius="12" Padding="16" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.diskHealth.volumes}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                <TextBlock x:Name="VolumesText" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

