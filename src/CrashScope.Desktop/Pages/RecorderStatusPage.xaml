<UserControl x:Class="CrashScope.Desktop.Pages.RecorderStatusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="Recorder Status"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}"
                       Margin="0,0,0,8"/>
            <TextBlock Text="Control and monitor the flight recorder agent"
                       FontSize="13"
                       Foreground="{StaticResource TextSecondary}"
                       Margin="0,0,0,24"/>

            <!-- Status Card -->
            <Border Background="{StaticResource CardBg}"
                    CornerRadius="12" Padding="24" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <Ellipse x:Name="StatusDot" Width="12" Height="12"
                                 Fill="{StaticResource DangerColor}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="RecorderStatusLabel"
                                   Text="STOPPED"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="#0F0F1A" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Session"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="SessionIdText" Text="--"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0F0F1A" CornerRadius="8" Padding="12" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="Uptime"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="UptimeText" Text="--"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0F0F1A" CornerRadius="8" Padding="12" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Samples"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="SampleCountText" Text="0"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button x:Name="StartStopButton"
                                Content="&#xE768;  Start Recording"
                                Width="160" Height="36"
                                FontSize="13"
                                Click="StartStopButton_Click"
                                Style="{StaticResource AccentButton}"/>
                        <Button Content="&#xE74C;  Open Data Folder"
                                Width="160" Height="36"
                                FontSize="13" Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                Click="OpenDataFolder_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Session Info Card -->
            <Border Background="{StaticResource CardBg}"
                    CornerRadius="12" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Session Details"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Data Directory" Grid.Row="0" Grid.Column="0"
                                   Foreground="{StaticResource TextSecondary}" FontSize="12"
                                   Margin="0,0,16,0"/>
                        <TextBlock x:Name="DataDirText" Grid.Row="0" Grid.Column="1"
                                   Text="--" Foreground="{StaticResource TextPrimary}" FontSize="12"/>

                        <TextBlock Text="Elevated" Grid.Row="1" Grid.Column="0"
                                   Foreground="{StaticResource TextSecondary}" FontSize="12"
                                   Margin="0,0,16,0"/>
                        <TextBlock x:Name="ElevatedText" Grid.Row="1" Grid.Column="1"
                                   Text="--" Foreground="{StaticResource TextPrimary}" FontSize="12"/>

                        <TextBlock Text="Previous Session" Grid.Row="2" Grid.Column="0"
                                   Foreground="{StaticResource TextSecondary}" FontSize="12"
                                   Margin="0,0,16,0"/>
                        <TextBlock x:Name="PreviousSessionText" Grid.Row="2" Grid.Column="1"
                                   Text="--" Foreground="{StaticResource TextPrimary}" FontSize="12"/>

                        <TextBlock Text="Agent Version" Grid.Row="3" Grid.Column="0"
                                   Foreground="{StaticResource TextSecondary}" FontSize="12"
                                   Margin="0,0,16,0"/>
                        <TextBlock x:Name="AgentVersionText" Grid.Row="3" Grid.Column="1"
                                   Text="v0.5.0-dev" Foreground="{StaticResource TextPrimary}" FontSize="12"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Write-throughput Card -->
            <Border Background="{StaticResource CardBg}"
                    CornerRadius="12" Padding="24">
                <StackPanel>
                    <TextBlock Text="Write Throughput"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="#0F0F1A" CornerRadius="8" Padding="10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Telemetry"
                                           FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="TelemetryHzText" Text="1 Hz"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentColor}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0F0F1A" CornerRadius="8" Padding="10" Margin="3,0">
                            <StackPanel>
                                <TextBlock Text="Foreground"
                                           FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="ForegroundHzText" Text="1 Hz"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentColor}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0F0F1A" CornerRadius="8" Padding="10" Margin="3,0">
                            <StackPanel>
                                <TextBlock Text="GPU Engines"
                                           FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="GpuEngineHzText" Text="0.5 Hz"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentColor}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0F0F1A" CornerRadius="8" Padding="10" Margin="3,0">
                            <StackPanel>
                                <TextBlock Text="Processes"
                                           FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="ProcessHzText" Text="0.5 Hz"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentColor}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0F0F1A" CornerRadius="8" Padding="10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Snapshot"
                                           FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="SnapshotHzText" Text="1/30 Hz"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentColor}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>