<UserControl x:Class="CrashScope.Desktop.Pages.RecorderStatusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="{DynamicResource L.recorder.title}"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"
                       Margin="0,0,0,8"/>
            <TextBlock Text="{DynamicResource L.recorder.subtitle}"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,0,0,24"/>

            <!-- Status Card -->
            <Border Background="{DynamicResource CardBg}"
                    CornerRadius="12" Padding="24" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <Ellipse x:Name="StatusDot" Width="12" Height="12"
                                 Fill="{DynamicResource DangerColor}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="RecorderStatusLabel"
                                   Text="{DynamicResource L.recorder.status.stopped}"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="#0F0F1A" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L.recorder.cards.session}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock x:Name="SessionIdText" Text="--"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0F0F1A" CornerRadius="8" Padding="12" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L.recorder.cards.uptime}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock x:Name="UptimeText" Text="--"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0F0F1A" CornerRadius="8" Padding="12" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L.recorder.cards.samples}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock x:Name="SampleCountText" Text="0"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button x:Name="StartStopButton"
                                Content="{DynamicResource L.recorder.buttons.startRecording}"
                                Width="160" Height="36"
                                FontSize="13"
                                Click="StartStopButton_Click"
                                Style="{StaticResource AccentButton}"/>
                        <Button Content="{DynamicResource L.recorder.buttons.openDataFolder}"
                                Width="160" Height="36"
                                FontSize="13" Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                Click="OpenDataFolder_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Session Info Card -->
            <Border Background="{DynamicResource CardBg}"
                    CornerRadius="12" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.recorder.sessionDetails}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="26"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{DynamicResource L.recorder.dataDirectory}" Grid.Row="0" Grid.Column="0"
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                   Margin="0,0,16,0"/>
                        <TextBlock x:Name="DataDirText" Grid.Row="0" Grid.Column="1"
                                   Text="--" Foreground="{DynamicResource TextPrimary}" FontSize="12"/>

                        <TextBlock Text="{DynamicResource L.recorder.elevated}" Grid.Row="1" Grid.Column="0"
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                   Margin="0,0,16,0"/>
                        <TextBlock x:Name="ElevatedText" Grid.Row="1" Grid.Column="1"
                                   Text="--" Foreground="{DynamicResource TextPrimary}" FontSize="12"/>

                        <TextBlock Text="{DynamicResource L.recorder.previousSession}" Grid.Row="2" Grid.Column="0"
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                   Margin="0,0,16,0"/>
                        <TextBlock x:Name="PreviousSessionText" Grid.Row="2" Grid.Column="1"
                                   Text="--" Foreground="{DynamicResource TextPrimary}" FontSize="12"/>

                        <TextBlock Text="{DynamicResource L.recorder.agentVersion}" Grid.Row="3" Grid.Column="0"
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                   Margin="0,0,16,0"/>
                        <TextBlock x:Name="AgentVersionText" Grid.Row="3" Grid.Column="1"
                                   Text="v0.5.0-dev" Foreground="{DynamicResource TextPrimary}" FontSize="12"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Write-throughput Card -->
            <Border Background="{DynamicResource CardBg}"
                    CornerRadius="12" Padding="24">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.recorder.writeThroughput}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="#0F0F1A" CornerRadius="8" Padding="10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L.common.telemetry}"
                                           FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock x:Name="TelemetryHzText" Text="1 Hz"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentColor}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0F0F1A" CornerRadius="8" Padding="10" Margin="3,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L.common.foreground}"
                                           FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock x:Name="ForegroundHzText" Text="1 Hz"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentColor}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0F0F1A" CornerRadius="8" Padding="10" Margin="3,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L.common.gpuEngines}"
                                           FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock x:Name="GpuEngineHzText" Text="0.5 Hz"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentColor}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0F0F1A" CornerRadius="8" Padding="10" Margin="3,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L.common.processes}"
                                           FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock x:Name="ProcessHzText" Text="0.5 Hz"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentColor}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0F0F1A" CornerRadius="8" Padding="10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource L.common.snapshot}"
                                           FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock x:Name="SnapshotHzText" Text="1/30 Hz"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentColor}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
