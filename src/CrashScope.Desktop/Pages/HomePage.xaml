<UserControl x:Class="CrashScope.Desktop.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="CrashScope Toolbox"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}"
                       Margin="0,0,0,4"/>
            <TextBlock Text="PC 玩家工具箱 · 硬件监控 · 故障黑匣子 · 本地优先"
                       FontSize="13"
                       Foreground="{StaticResource TextSecondary}"
                       Margin="0,0,0,20"/>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Recorder Status -->
                <Border Grid.Column="0" Background="{StaticResource CardBg}"
                        CornerRadius="12" Padding="20" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Recorder" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Ellipse x:Name="StatusDot" Width="12" Height="12"
                                     Fill="{StaticResource DangerColor}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="RecorderStateText" Text="Stopped"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                        <TextBlock x:Name="SessionText" Text="Session: --"
                                   FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SamplesText" Text="Samples: 0"
                                   FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="ErrorText" Text="" FontSize="11"
                                   Foreground="{StaticResource DangerColor}" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="Collapsed"/>
                        <TextBlock x:Name="RecoveryText" Text="" FontSize="11"
                                   Foreground="#FFD93D" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="StartStopButton" Content="&#xE768;  Start"
                                    FontFamily="{StaticResource IconTextFont}" Width="120" Height="32" FontSize="12"
                                    Style="{StaticResource AccentButton}" Click="StartStopButton_Click" Margin="0,0,8,0"/>
                            <Button x:Name="CheckButton" Content="检查上次异常" Width="110" Height="32" FontSize="12"
                                    Style="{StaticResource SecondaryButton}" Click="CheckButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Hardware Summary -->
                <Border Grid.Column="1" Background="{StaticResource CardBg}"
                        CornerRadius="12" Padding="20" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Hardware Summary" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
                        <TextBlock x:Name="CpuText" Text="CPU: Detecting..." FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <TextBlock x:Name="GpuText" Text="GPU: Detecting..." FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <TextBlock x:Name="RamText" Text="RAM: --" FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="DataRootText" Text="Data: --" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ElevationText" Text="Privilege: --" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Quick Actions -->
            <Border Background="{StaticResource CardBg}" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Quick Actions" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button Tag="Dashboard" Content="&#xE9D2;  Dashboard" FontFamily="{StaticResource IconTextFont}"
                                Width="140" Height="36" Margin="0,0,8,8"
                                Style="{StaticResource SecondaryButton}" Click="QuickNav_Click"/>
                        <Button Tag="LiveMonitor" Content="&#xE7F7;  Live Monitor" FontFamily="{StaticResource IconTextFont}"
                                Width="140" Height="36" Margin="0,0,8,8"
                                Style="{StaticResource SecondaryButton}" Click="QuickNav_Click"/>
                        <Button Tag="Hardware" Content="&#xE950;  Hardware" FontFamily="{StaticResource IconTextFont}"
                                Width="140" Height="36" Margin="0,0,8,8"
                                Style="{StaticResource SecondaryButton}" Click="QuickNav_Click"/>
                        <Button Tag="Incidents" Content="&#xEA80;  Incidents" FontFamily="{StaticResource IconTextFont}"
                                Width="140" Height="36" Margin="0,0,8,8"
                                Style="{StaticResource SecondaryButton}" Click="QuickNav_Click"/>
                        <Button Tag="Timeline" Content="&#xE8F0;  Timeline" FontFamily="{StaticResource IconTextFont}"
                                Width="140" Height="36" Margin="0,0,8,8"
                                Style="{StaticResource SecondaryButton}" Click="QuickNav_Click"/>
                        <Button Tag="Settings" Content="&#xE713;  Settings" FontFamily="{StaticResource IconTextFont}"
                                Width="140" Height="36" Margin="0,0,8,8"
                                Style="{StaticResource SecondaryButton}" Click="QuickNav_Click"/>
                    </WrapPanel>
                    <TextBlock Text="所有系统修改需填写原因并可回滚，默认仅被动采集。"
                               FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Recent Incidents -->
            <Border Background="{StaticResource CardBg}" CornerRadius="12" Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Recent Incidents" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <Button Grid.Column="1" Content="查看全部" FontSize="11"
                                Style="{StaticResource SecondaryButton}" Width="80" Height="28"
                                Click="ViewAllIncidents_Click"/>
                    </Grid>
                    <TextBlock x:Name="IncidentsEmptyText" Text="暂无异常记录，录制器正在保护现场。"
                               FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                    <ListView x:Name="IncidentsList" Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0F0F1A" CornerRadius="8" Padding="12" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DirectoryName}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="{Binding Mode}" FontSize="11"
                                                       Foreground="{StaticResource AccentColor}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Timestamp}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
