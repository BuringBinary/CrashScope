<UserControl x:Class="CrashScope.Desktop.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Foreground="{DynamicResource TextPrimary}">
    <ScrollViewer x:Name="HomeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,16">
            <!-- First-screen budget (product plan 5.1): at 1200x750 / 100% with the scroll at zero the
                 recorder state, the three metrics and at least two recent records must all be visible.
                 The UI smoke asserts this, so any extra vertical air added here will fail that check. -->
            <TextBlock Text="{DynamicResource L.overviewUi.eyebrow}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}"/>
            <TextBlock Text="{DynamicResource L.overviewUi.title}" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,2" TextWrapping="Wrap"/>
            <TextBlock Text="{DynamicResource L.overviewUi.subtitle}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <Border Style="{StaticResource SurfaceCard}" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource AccentColor}" CornerRadius="2"/>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="{DynamicResource L.home.recorder}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{DynamicResource TextSecondary}" Margin="0,0,10,0"/>
                            <TextBlock x:Name="RecorderStateText" Text="{DynamicResource L.overviewUi.stopped}" FontSize="20" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="CollectionHealthText" Text="{DynamicResource L.home.collectionStopped}" FontSize="13" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerColor}" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,6,0,0"/>
                        <TextBlock x:Name="RecoveryText" Foreground="{DynamicResource WarningColor}" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,6,0,0"/>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock x:Name="SampleStateText" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                            <TextBlock x:Name="SampleAgeText" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="12,0,0,0"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="StartStopButton" Content="{DynamicResource L.common.start}" ContentTemplate="{StaticResource IconTextTemplate}"
                                    MinWidth="126" Margin="0,0,10,4" Style="{StaticResource AccentButton}" Click="StartStopButton_Click"/>
                            <Button x:Name="CheckButton" Content="{DynamicResource L.home.checkLast}" MinWidth="126" Margin="0,0,0,4"
                                    Style="{StaticResource SecondaryButton}" Click="CheckButton_Click"/>
                            <Button ContentTemplate="{StaticResource IconTextTemplate}" x:Name="OpenDataFolderButton" Content="{DynamicResource L.recorder.buttons.openDataFolder}"
                                    MinWidth="126" Margin="10,0,0,4"
                                    Style="{StaticResource SecondaryButton}" Click="OpenDataFolder_Click"/>
                        </WrapPanel>
                    </StackPanel>
                    <!-- Live session counters merged in from the retired Recorder page. They sit beside the
                         state column rather than under the buttons so they add no height to the card. -->
                    <StackPanel Grid.Column="2" Margin="24,0,0,0" MinWidth="88" VerticalAlignment="Top">
                        <TextBlock Text="{DynamicResource L.recorder.cards.uptime}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock x:Name="UptimeText" Text="--" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                        <TextBlock Text="{DynamicResource L.recorder.cards.samples}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock x:Name="SampleCountText" Text="0" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                        <TextBlock Text="{DynamicResource L.recorder.cards.session}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock x:Name="SessionIdText" Text="--" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                   MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SurfaceCard}" Padding="12" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.overviewUi.cpu}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource CpuColor}"/>
                        <TextBlock x:Name="CpuValueText" Text="—" Style="{StaticResource MetricValue}"/>
                        <TextBlock x:Name="CpuText" Text="{DynamicResource L.home.cpuNotRecording}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="CpuAvailabilityText" Style="{StaticResource AutoHideText}" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource SurfaceCard}" Padding="12" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.overviewUi.gpu}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource GpuColor}"/>
                        <TextBlock x:Name="GpuValueText" Text="—" Style="{StaticResource MetricValue}"/>
                        <TextBlock x:Name="GpuText" Text="{DynamicResource L.home.gpuNotRecording}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="GpuAvailabilityText" Style="{StaticResource AutoHideText}" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource SurfaceCard}" Padding="12" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L.overviewUi.memory}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource RamColor}"/>
                        <TextBlock x:Name="RamValueText" Text="—" Style="{StaticResource MetricValue}"/>
                        <TextBlock x:Name="RamText" Text="{DynamicResource L.home.ramPlaceholder}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="RamAvailabilityText" Style="{StaticResource AutoHideText}" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            <!-- Recent Incidents -->
            <Border Style="{StaticResource SurfaceCard}" Padding="16">
                <StackPanel>
                    <!-- Reload lives in the header row next to "view all" instead of on its own row,
                         which is what buys the second visible record on the first screen. -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource L.home.recentIncidents}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        <Button x:Name="ReloadIncidentsButton" Grid.Column="1" Content="{DynamicResource L.readUi.retry}" FontSize="12"
                                Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,0"
                                Click="ReloadIncidents_Click"/>
                        <Button Grid.Column="2" Content="{DynamicResource L.home.viewAll}" FontSize="12"
                                Style="{StaticResource SecondaryButton}" MinWidth="90" Padding="12,6"
                                Click="ViewAllIncidents_Click"/>
                    </Grid>
                    <TextBlock x:Name="IncidentsEmptyText" Text="{DynamicResource L.home.noIncidents}"
                               FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="IncidentReadNotice" Style="{StaticResource AutoHideText}" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Expander x:Name="IncidentReadIssues" Header="{DynamicResource L.readUi.details}" Foreground="{DynamicResource WarningColor}" Visibility="Collapsed" Margin="0,0,0,10">
                        <TextBox x:Name="IncidentReadDetails" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="140" VerticalScrollBarVisibility="Auto" Background="{DynamicResource CardBgAlt}" Foreground="{DynamicResource TextPrimary}"/>
                    </Expander>
                    <ListView x:Name="IncidentsList" Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template"><Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="ItemBorder" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8"><ContentPresenter/></Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}"/></Trigger>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource FocusColor}"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value></Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Button Click="OpenIncident_Click" Style="{StaticResource SecondaryButton}"
                                        HorizontalContentAlignment="Stretch" Padding="12,8" Margin="0,0,0,6"
                                        AutomationProperties.Name="{Binding TimeLabel}" ToolTip="{Binding TimeDetail}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                            <!-- Classification and "last recorded" time share one line; both wrap
                                                 independently when the window is narrow. -->
                                            <WrapPanel Margin="0,2,0,0">
                                                <TextBlock Text="{Binding ModeLabel}" FontSize="12" Foreground="{DynamicResource AccentColor}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding TimeLabel}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="12,0,0,0"/>
                                            </WrapPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{DynamicResource L.eventUi.open}" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <TextBlock Text="{DynamicResource L.overviewUi.next}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,16,0,10"/>
            <WrapPanel>
                <Button Tag="Dashboard" Content="{DynamicResource L.nav.dashboard}" ContentTemplate="{StaticResource IconTextTemplate}" Margin="0,0,10,10" Style="{StaticResource SecondaryButton}" Click="QuickNav_Click"/>
                <Button Tag="Timeline" Content="{DynamicResource L.nav.timeline}" ContentTemplate="{StaticResource IconTextTemplate}" Margin="0,0,10,10" Style="{StaticResource SecondaryButton}" Click="QuickNav_Click"/>
                <Button Tag="Hardware" Content="{DynamicResource L.nav.hardware}" ContentTemplate="{StaticResource IconTextTemplate}" Margin="0,0,10,10" Style="{StaticResource SecondaryButton}" Click="QuickNav_Click"/>
            </WrapPanel>
            <Expander Header="{DynamicResource L.overviewUi.details}" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0" FontSize="12">
                <StackPanel Margin="4,12,0,0">
                    <TextBlock x:Name="SessionText" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock x:Name="SamplesText" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock x:Name="DataRootText" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock x:Name="ElevationText" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <!-- Previous-session outcome + capture cadence, merged in from the retired
                         Recorder page. Agent version is already part of ElevationText above. -->
                    <TextBlock x:Name="PreviousSessionText" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock x:Name="CadenceText" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource L.home.safetyNote}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
