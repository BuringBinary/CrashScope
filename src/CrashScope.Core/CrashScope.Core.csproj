<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CrashScope.Core</AssemblyName>
    <RootNamespace>CrashScope.Core</RootNamespace>
    <Version>0.9.0</Version>
    <Description>CrashScope core library – monitoring, analysis, and diagnostics engine</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrashScope.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CrashScope.Contracts\CrashScope.Contracts.csproj" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.15" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.1" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.1" />
    <PackageReference Include="System.Management" Version="10.0.2" />
  </ItemGroup>
</Project>